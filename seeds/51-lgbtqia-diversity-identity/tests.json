{
  "schema": "lantern.foundation.tests.v1",
  "package_id": "foundation.lgbtqia_diversity_identity",
  "package_version": "0.1.0",
  "cases": [
    {
      "id": "orientation-gender",
      "premises": [
        "SEXUAL_ORIENTATION(P,O)"
      ],
      "query": "GENDER_IDENTITY_DETERMINED(P)",
      "expected": "NO",
      "guard": "guard.orientation_not_gender"
    },
    {
      "id": "expression",
      "premises": [
        "GENDER_EXPRESSION(P,E)"
      ],
      "query": "GENDER_IDENTITY_DETERMINED(P)",
      "expected": "NO",
      "guard": "guard.expression_not_identity"
    },
    {
      "id": "pronouns",
      "premises": [
        "P USES_PRONOUNS Pr"
      ],
      "query": "EXACT_GENDER_IDENTITY_DETERMINED(P)",
      "expected": "NO",
      "guard": "guard.pronouns_not_unique_gender"
    },
    {
      "id": "trans-dysphoria",
      "premises": [
        "P TRANSGENDER"
      ],
      "query": "P MUST_HAVE_GENDER_DYSPHORIA",
      "expected": "NO",
      "guard": "guard.trans_not_dysphoria_required"
    },
    {
