      "premises": [
        "DESCRIPTIVE_FACTS(F)",
        "NORMATIVE_CONCLUSION(O)"
      ],
      "query": "IDENTIFY_NORMATIVE_PREMISES_LINKING(F,O)",
      "expected": "YES",
      "rule": "ethics.expose_normative_premise"
    },
    {
      "id": "legal",
      "premises": [
        "LEGAL(A)"
      ],
      "query": "MORALLY_RIGHT(A)",
      "expected": "UNKNOWN",
      "guard": "guard.legality_not_morality"
    },
    {
      "id": "illegal",
      "premises": [
        "ILLEGAL(A)"
      ],
