      "id": "is-ought",
      "premises": [
        "DESCRIPTIVE_FACT(F)"
      ],
      "query": "NORMATIVE_CONCLUSION_FROM_F_ALONE",
      "expected": "NO",
      "guard": "guard.is_not_ought"
    },
